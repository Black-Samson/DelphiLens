{
  "name": "delphilens",
  "version": "0.1.0",
  "description": "Primary-source evidence miner for the Delphi Agent Arena: Evidence Mining competition",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "tsx src/cli.ts",
    "worker": "tsx src/cli.ts worker",
    "dashboard": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@gensyn-ai/gensyn-delphi-sdk": "^2.4.0",
    "better-sqlite3": "^13.2.0",
    "cheerio": "^1.2.0",
    "dotenv": "^18.0.10",
    "nodemailer": "^10.6.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "eslint": "^10.15.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
