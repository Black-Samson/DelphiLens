# ---------------------------------------------------------------
# DelphiLens configuration. Copy to .env and fill in.
# ---------------------------------------------------------------

# --- Agent identity ---------------------------------------------
# AGENT_ID is locked to DelphiLens. It is sent as X-Agent-Id on
# every Delphi request so results show under the agent's name.
AGENT_ID=DelphiLens
AGENT_HARNESS=DelphiLens
AGENT_MODEL=

# --- Run mode ---------------------------------------------------
# MOCK_MODE=true runs fully offline with sample markets and a fake judge.
MOCK_MODE=true
# AUTO_SUBMIT=false queues drafts for your approval in the dashboard.
AUTO_SUBMIT=false

# --- Delphi ---------------------------------------------------
# Create a MAINNET API key at https://api-access.delphi.fyi, signed in the
# same way you sign in to Delphi. Never commit or share it.
DELPHI_API_ACCESS_KEY=
# The wallet shown on your Delphi profile (the one the key was created with).
# Only used to send feedback to https://feedback.delphi.fyi.
DELPHI_WALLET=
# These defaults come from the competition guide; leave them as they are.
DELPHI_EVIDENCE_BASE_URL=https://delphi.fyi/v1
MARKETS_SOURCE=url
MARKETS_URL=https://competition.delphi.fyi/markets.json

# --- Research providers -----------------------------------------
# Search: Tavily (https://tavily.com). Leave empty to use mock search.
SEARCH_API_KEY=
# LLM: any OpenAI-compatible chat completions API
# (OpenAI, OpenRouter, Groq, Gemini's OpenAI endpoint...).
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Optional: a GitHub token (no permissions needed) raises GitHub's API limit
# from 60 to 5,000 requests an hour, for release markets (Bun, Node, Go...).
# Create one at https://github.com/settings/tokens (fine-grained, public repos, read-only).
GITHUB_TOKEN=

# --- Research tuning --------------------------------------------
# Only facts from the last N days. The forecaster researches on its own, so older
# facts are usually already known (judge verdict: "We already have this information").
MAX_SOURCE_AGE_DAYS=3
WORKER_INTERVAL_MINUTES=30
# How often the worker checks for newly opened markets between cycles.
# New markets are mined straight away: getting there first matters.
MARKET_POLL_MINUTES=5

# --- Dashboard --------------------------------------------------
DASHBOARD_PORT=8501

# --- Optional digest delivery -----------------------------------
DISCORD_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
DIGEST_EMAIL_FROM=
DIGEST_EMAIL_TO=
